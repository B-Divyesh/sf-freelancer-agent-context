{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Client Context Firewall",
  "version": "0.1.3",
  "identifier": "in.sociobot.freelancer-agent-context",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173/app",
    "beforeBuildCommand": "npm run build:site",
    "frontendDist": "../dist/site"
  },
  "app": {
    "security": { "csp": "default-src 'self' asset: https://asset.localhost; script-src 'self'; style-src 'self'; img-src 'self' asset: https://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost https://api.sociobot.in; object-src 'none'" },
    "windows": [{ "title": "Client Context Firewall", "width": 1240, "height": 820, "minWidth": 390, "minHeight": 640, "resizable": true }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright 2026 Param Factory",
    "category": "DeveloperTool",
    "shortDescription": "Keep client workspaces apart",
    "longDescription": "A local boundary for freelance developers switching between client work.",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "linux": { "appimage": { "bundleMediaFramework": false }, "deb": { "depends": [] } }
  }
}
